# Only VITE_ prefixed values reach the client bundle, and everything in it is public by
# definition. No secrets, API keys, or model keys belong here (NFR-2.6).

# Serve the app against the MSW mock API. Defaults to true while there is no backend.
# Set to false to build against a real API; the mock chunk is then never fetched.
VITE_ENABLE_MOCK_API=true
