# BoltSupport, repository root.
#
# Patterns without a leading slash match at any depth, so a single rule here covers app/ and any
# other subdirectory that grows one later. Rules that must only apply to the root are anchored
# with a leading slash.

# Dependencies -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Build output -----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# Test and coverage output -----------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
.vitest-cache/

# Caches -----------------------------------------------------------------------------------
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.turbo/
.rollup.cache/
*.tsbuildinfo

# Environment ------------------------------------------------------------------------------
#
# Secrets never belong in history, and a leaked key is not fixed by a later commit. The example
# file is the exception: it documents the shape without carrying a value.
.env
.env.*
!.env.example

# Logs -------------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating system -------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editors ----------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# Claude Code ------------------------------------------------------------------------------
#
# The skill and the launch config are shared work and stay tracked. Only the per machine
# overrides are ignored, since they carry one person's paths and permissions.
.claude/settings.local.json
.claude/plans/
